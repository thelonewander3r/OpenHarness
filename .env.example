# Copy to .env and fill in your values. Never commit .env to git.
# Get a key: https://openrouter.ai/keys

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HARNESS_PORT=3100
HARNESS_HOST=0.0.0.0

HARNESS_DECOMP_MODEL=anthropic/claude-3.5-haiku
HARNESS_WORKER_MODEL=deepseek/deepseek-chat
HARNESS_AUDITOR_MODEL=anthropic/claude-3.5-haiku
HARNESS_MAX_AUDITOR_RETRIES=3

# Optional: custom registries (default to the bundled config/*.json files).
# All registries hot-reload on file change while the proxy runs.
#HARNESS_FRONTIER_MODELS_PATH=
#HARNESS_WORKER_MODELS_PATH=
#HARNESS_MODEL_PRICING_PATH=

# Optional: OpenTelemetry tracing (spans per request / micro-task / upstream call).
# Without an OTLP endpoint, spans print to the console. OTLP needs: pip install -e ".[otel]"
#HARNESS_OTEL_ENABLED=1
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
