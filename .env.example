OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HARNESS_PORT=3100
HARNESS_HOST=0.0.0.0

HARNESS_DECOMP_MODEL=anthropic/claude-3.5-haiku
HARNESS_WORKER_MODEL=deepseek/deepseek-chat
HARNESS_AUDITOR_MODEL=anthropic/claude-3.5-haiku
HARNESS_MAX_AUDITOR_RETRIES=3
